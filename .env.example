# ───────────────────────────────────────────────────────────────
# Narrative Operator NLP — Environment Configuration
# ───────────────────────────────────────────────────────────────
# Copy this file to .env and customize:
#   cp .env.example .env
# ───────────────────────────────────────────────────────────────

# FastAPI HTTP server port (host → container)
# Demo 页面: http://localhost:8000/demo  (含 API 接口说明标签页)
# Swagger UI: http://localhost:8000/docs
HTTP_PORT=8000

# gRPC server port (host → container)
# Set to 50051 for TCP, or leave default for Unix Domain Socket
GRPC_PORT=50051

# Desired model set: MTL | LZH | PIPELINE | ALL
# MTL = modern Chinese (required, ~500MB)
# LZH = classical Chinese (~300MB)
# ALL = everything including pipeline models
# NOTE: the entrypoint currently auto-downloads MTL only; other model sets
# must be pre-downloaded into the model volume (see docs/deployment.md).
HANLP_MODEL_SET=ALL

# HanLP model cache directory (inside container)
HANLP_HOME=/root/.hanlp

# Python environment
PYTHONUNBUFFERED=1
TOKENIZERS_PARALLELISM=false
